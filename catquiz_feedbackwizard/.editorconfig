# EditorConfig for block_catquiz_feedbackwizard.
# https://editorconfig.org

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated by grunt/rollup. These files must stay byte-identical to what the
# build produces, otherwise "moodle-plugin-ci grunt" rebuilds them, compares
# sha1 sums and reports them as stale. Rollup writes the source map without a
# trailing newline, so an editor that adds one on save breaks CI even though
# nobody changed a line of code.
[amd/build/**]
insert_final_newline = false
trim_trailing_whitespace = false
